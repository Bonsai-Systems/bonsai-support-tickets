<?xml version="1.0"?>
<phpunit
	bootstrap="tests/bootstrap.php"
	colors="true"
	beStrictAboutOutputDuringTests="true"
>
	<testsuites>
		<!-- Pure PHP: email parsing. Runs anywhere: composer test -->
		<testsuite name="unit">
			<directory suffix="Test.php">./tests/unit/</directory>
		</testsuite>
		<!-- Needs the WordPress test suite: WP_TESTS_DIR=/path/to/wordpress-tests-lib vendor/bin/phpunit -testsuite integration -->
		<testsuite name="integration">
			<directory suffix="Test.php">./tests/integration/</directory>
		</testsuite>
	</testsuites>
</phpunit>
